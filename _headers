# Cloudflare Pages response headers
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# HTML is always revalidated so a deploy shows up immediately
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Assets are referenced with ?v=<content hash> (see build.mjs), so they can be cached for good
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Build sources and docs are not meant to be public
/README.md
  X-Robots-Tag: noindex
/src/*
  X-Robots-Tag: noindex
/build.mjs
  X-Robots-Tag: noindex
